# Backend environment variables
# Copy this file to .env and fill in your actual values

# Google Gemini API key for OCR processing
GEMINI_API_KEY=your-gemini-api-key

# Supabase credentials (same as frontend uses)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare Turnstile secret (this value is Cloudflare's always-pass test key for local dev)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Flask environment (set to production when deployed)
FLASK_ENV=development
